# Copy to .env and change every CHANGE_ME value. Never commit .env.
POSTGRES_PASSWORD=CHANGE_ME_local_db_password
# python -c "import secrets; print(secrets.token_urlsafe(48))"
MMA_JWT_SECRET=CHANGE_ME_at_least_32_random_characters_long
MMA_ENV=development
MMA_COOKIE_SECURE=false
MMA_CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
MMA_LOG_JSON=true
# Password for the demo users created by `python -m app.cli load-demo` (min 12 chars).
MMA_DEMO_PASSWORD=CHANGE_ME_demo_password

# --- answering ---
# "auto": Claude when ANTHROPIC_API_KEY is set, otherwise local models only (nothing leaves the server).
MMA_LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...      # enables Claude; messages, file text and images are then sent to Anthropic
MMA_CLAUDE_MODEL=claude-opus-5-5
MMA_CLAUDE_EFFORT=medium

# --- local models (all run on CPU) ---
MMA_STT_MODEL=base.en               # faster-whisper: tiny.en (fastest) | base.en | small.en (most accurate)
MMA_TTS_VOICE=en_US-ljspeech-medium   # any voice from huggingface.co/rhasspy/piper-voices
MMA_MAX_UPLOAD_MB=25
MMA_MAX_AUDIO_SECONDS=600
